# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit .env to source control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=reminders
POSTGRES_USER=reminder_user
POSTGRES_PASSWORD=change_me_before_use

# ── Reminder policy ───────────────────────────────────────────────────────────
REMINDER_THRESHOLD_HOURS=48
REMINDER_COOLDOWN_HOURS=24

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info
