# =============================================================================
# .env.example — copy to .env and fill in real values before running
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# =============================================================================

# ── PostgreSQL credentials (REQUIRED) ─────────────────────────────────────────
POSTGRES_USER=reminder_user
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_DB=reminder_db

# ── Optional: expose Postgres on a different host port (default 5432) ─────────
# POSTGRES_HOST_PORT=5432

# ── Reminder policy ───────────────────────────────────────────────────────────
REMINDER_THRESHOLD_HOURS=48
REMINDER_COOLDOWN_HOURS=24

# ── Scheduler run interval in seconds ─────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=300

# ── Application log level ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
